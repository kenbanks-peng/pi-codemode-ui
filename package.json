{
  "name": "@npm-ken/pi-codemode-ui",
  "version": "0.2.0",
  "description": "Display-only compact codemode rendering for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  }
}
